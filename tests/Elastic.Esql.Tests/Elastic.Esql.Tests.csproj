<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(SolutionRoot)/build/keys/keypair.snk</AssemblyOriginatorKeyFile>
    <!-- PrivateSetterModel needs a private setter the System.Text.Json source generator cannot reach. The generator's
         diagnostics ignore #pragma, [SuppressMessage] and per-file .editorconfig severity, so only a compilation-wide
         setting such as NoWarn silences it. -->
    <!-- AttributedHandWrittenContext carries [JsonSerializable] without being partial, which the generator reports. -->
    <NoWarn>$(NoWarn);SYSLIB1032;SYSLIB1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionRoot)\src\Elastic.Esql\Elastic.Esql.csproj" />
  </ItemGroup>
</Project>
